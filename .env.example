# =============================================================================
# MATRIX AI — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# =============================================================================

# --- Frontend (safe to expose to the browser) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# There is NO demo mode. MATRIX only works against real services: if the
# Supabase variables above are missing/invalid, the app renders honest
# "Server problem — service not configured" screens instead of fake data.

# --- Server-side only (never expose to the browser) --------------------------
# Supabase service_role key — ONLY used in server-side code / edge functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API key — ONLY used server-side by the AI gateway (edge function).
GROQ_API_KEY=gsk_...

# HMAC secret for Supabase Auth webhooks (Edge Function `auth-events`).
SUPABASE_WEBHOOK_SECRET=your-auth-webhook-signing-secret

# SMTP (optional, for custom transactional email via Supabase Auth SMTP config)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MATRIX AI <safety@example.com>

# Encryption key for sensitive stored values (e.g. export signing).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars
