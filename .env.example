# =============================================================================
# MATRIX AI — environment variables (Firebase edition)
# Copy to .env.local and fill in. NEVER commit real secrets.
# =============================================================================

# --- Frontend (safe to expose to the browser) -------------------------------
# Firebase console → Project settings → General → Your apps → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
NEXT_PUBLIC_APP_URL=http://localhost:3000

# There is NO demo mode. MATRIX only works against real services: if the
# variables above are missing/invalid, the app renders honest
# "Server problem — service not configured" screens instead of fake data.

# --- Local QA with Firebase emulators (npm run emulators) --------------------
# Point the browser SDK at the local Auth/Firestore emulators instead of the
# live project. The server side uses FIREBASE_AUTH_EMULATOR_HOST /
# FIRESTORE_EMULATOR_HOST (set automatically by the firebase CLI).
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# --- Server-side only (never expose to the browser) --------------------------
# Firebase Admin service account — Firebase console → Project settings →
# Service accounts → Generate new private key. Use the client_email and the
# private_key (keep the \n escapes when pasting into a host like Render/Vercel).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR-PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Cloudinary (free tier) — private image storage for the screenshot scanner
# and age-verification documents. Dashboard → Settings → API keys.
# Uploads are server-signed and stored as private (authenticated) assets.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# --- AI provider fallbacks (server-side only) --------------------------------
# These are used ONLY when no admin OpenAI-compatible provider has been saved.
# Super admins can change the endpoint, model and API key at runtime without a
# redeploy from /admin/ai (stored server-side in Firestore system_settings).
#
# General chat fallback (server-side only).
GROQ_API_KEY=gsk_...

# Coding auto-routing + Agent mode fallback (server-side only). Agent falls
# back to NVIDIA Nemotron 3 Ultra through OpenRouter by default. The model can
# be overridden for controlled migrations without a code deploy. The default is
# the explicit OpenRouter free variant; a paid/custom slug must be chosen
# deliberately.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_CODING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Image generation (server-side only) -------------------------------------
# PREFERRED: configure the image provider from the app instead —
#   Admin -> AI configuration -> Image generation
# That stores the key AES-256-GCM encrypted in Firestore and never returns it
# to the browser. The variables below remain a fallback for deployments that
# prefer environment configuration. Never expose either to the browser.
TOGETHER_API_KEY=tgp_...
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# Key used to encrypt provider secrets saved from the Admin panel. Generate
# with: openssl rand -base64 32
# If unset, MATRIX falls back to GITHUB_TOKEN_ENCRYPTION_KEY, then to the
# Firebase private key, so an existing deployment keeps working.
PROVIDER_SECRET_KEY=

# GitHub connection for Agent mode. Create a GitHub OAuth App whose callback is
# https://YOUR-DOMAIN/api/github/callback. Generate the encryption key with:
#   openssl rand -base64 32
# Access tokens are encrypted before they are stored in Firestore.
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=github-oauth-secret
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/github/callback

# HMAC pepper for birth-certificate numbers (never store the raw number).
# Generate with: openssl rand -base64 32
IDENTITY_PEPPER=replace-with-at-least-32-random-characters

# One-time first-admin bootstrap at /admin/setup. After any admin exists it is closed.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-bootstrap-key
