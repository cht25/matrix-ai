# =============================================================================
# QORVYNA AI — environment variables (Firebase edition)
# Copy to .env.local and fill in. NEVER commit real secrets.
# =============================================================================

# --- Frontend (safe to expose to the browser) -------------------------------
# Firebase console → Project settings → General → Your apps → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
# authDomain names the origin that serves Firebase's auth helper
# (/__/auth/handler) — it is NOT "the website domain". For a Next.js app on a
# normal Node host (Render / App Hosting / Docker) keep the project's own
# domain, exactly as the console shows it. Only set the site's own hostname if
# you deliberately enable the /__/auth reverse proxy in this repository (see
# docs/AUTH_DOMAIN_MIGRATION.md).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
# Canonical public origin. Used for links/emails AND as one of the exact
# origins allowed to create the browser session cookie after sign-in.
NEXT_PUBLIC_APP_URL=https://qorvyna.thamjj13.top

# Extra exact origins allowed to perform authenticated browser mutations
# (comma-separated, scheme + host + port). Use it for a www host, a preview
# hostname, or the previous domain while it still redirects here. Leave empty
# if the site is served from exactly one origin.
# QORVYNA_ALLOWED_ORIGINS=https://www.qorvyna.thamjj13.top

# There is NO demo mode. QORVYNA only works against real services: if the
# variables above are missing/invalid, the app renders honest
# "Server problem — service not configured" screens instead of fake data.

# --- Local QA with Firebase emulators (npm run emulators) --------------------
# Point the browser SDK at the local Auth/Firestore emulators instead of the
# live project. The server side uses FIREBASE_AUTH_EMULATOR_HOST /
# FIRESTORE_EMULATOR_HOST (set automatically by the firebase CLI).
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# --- Server-side only (never expose to the browser) --------------------------
# Firebase Admin service account — Firebase console → Project settings →
# Service accounts → Generate new private key. Use the client_email and the
# private_key (keep the \n escapes when pasting into a host like Render/Vercel).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR-PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Cloudinary (free tier) — private image storage for the screenshot scanner
# and age-verification documents. Dashboard → Settings → API keys.
# Uploads are server-signed and stored as private (authenticated) assets.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# --- AI models ------------------------------------------------------------------
# One Groq key serves every language model QORVYNA can use. The default is
# GPT OSS 120B, served by Groq as `openai/gpt-oss-120b` (fixed in
# src/lib/ai/model.ts). The other registered models
# (src/lib/ai/models/registry.ts) can join a user's model pool only when Groq's
# live model list offers them to this account; a model that is not offered is
# shown as unavailable and is never sent a request. Model IDs are not
# configurable by environment variable. If the provider fails, the user sees
# the real error and can retry.
GROQ_API_KEY=gsk_...
# Optional additional Groq accounts. Each key is a separate account with its own
# limits; QORVYNA moves a request to another account only when the current one
# is rate limited, rejected or failing, and waits for the provider's retry time
# when all are limited. Accounts can also be added in Admin → AI → Provider
# accounts (stored encrypted). Use numbered keys and/or one comma-separated list.
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...
# GROQ_API_KEYS=gsk_...,gsk_...

# Optional: serve the SAME model from a dedicated OpenAI-compatible endpoint
# instead of Groq. Both values are required together. This replaces the Groq
# route; it is not a fallback. GPT_OSS_MODEL may only spell gpt-oss-120b the way
# that endpoint names it (`gpt-oss-120b` or `openai/gpt-oss-120b`).
# GPT_OSS_API_KEY=
# GPT_OSS_BASE_URL=
# GPT_OSS_MODEL=openai/gpt-oss-120b

# --- Cloudflare Workers AI (backend-only, free tier) --------------------------
# When BOTH values are set, Cloudflare Workers AI becomes the PRIMARY provider
# for normal chat, advanced chat and Agent mode; the existing providers stay
# configured as the automatic fallback (nothing is removed or replaced).
# The token never reaches the browser bundle or any client request.
#
# Where to find them:
#   Account ID  → Cloudflare dashboard → Workers & Pages → any project →
#                 right-hand "Workers AI" / account home → Account ID.
#   API token   → My Profile → API Tokens → Create Token → use the
#                 "Workers AI" template and verify it grants
#                 Workers AI - Read and Workers AI - Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Exact model id from the Cloudflare model catalog
# (https://developers.cloudflare.com/workers-ai/models/). Additional models
# can be registered in src/lib/ai/models/registry.ts — never assume an id.
CLOUDFLARE_DEFAULT_MODEL=@cf/zai-org/glm-4.7-flash
# Free plan: 10,000 Neurons per day, resetting at 00:00 UTC. The safety
# reserve keeps head-room for an in-flight answer; when actual Neuron usage
# cannot be read, a request budget is the safety net (a request count, never
# a token-based estimate). Paid billing is never enabled automatically.
# CLOUDFLARE_DAILY_NEURON_BUDGET=10000
# CLOUDFLARE_NEURON_SAFETY_RESERVE=500
# CLOUDFLARE_DAILY_REQUEST_BUDGET=400

# --- Speech (separate from the language model) ---------------------------------
# Voice input is transcribed by Whisper — Groq first (same GROQ_API_KEY), then
# OpenAI if OPENAI_API_KEY is set. The transcript is then sent to GPT OSS 120B
# as ordinary text. Whisper detects the spoken language itself; for mixed
# Bengali-English use GROQ_AUDIO_MODEL=whisper-large-v3.
# Cloudinary is only needed to keep a playable copy of voice messages.
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=
# OPENAI_AUDIO_MODEL=whisper-1
# Read-aloud uses the browser's speech synthesis unless an OpenAI-compatible
# speech endpoint is configured:
# OPENAI_TTS_MODEL=
# OPENAI_TTS_VOICE=
# OPENAI_BASE_URL=

# --- QORVYNA Connect QR device pairing -----------------------------------------
# Optional dedicated HMAC secret for signing pairing challenges. If unset, a
# key is derived server-side from the Firebase service-account credentials.
# PAIRING_HMAC_SECRET=

# --- Vercel deployment engine (Agent Studio) ----------------------------------
# Server-side only. Required before the Agent can create/monitor Vercel
# deployments and attach *.apps.thamjj13.top aliases.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# --- Image generation (media service, not a language model) -------------------
# Together AI. Can also be configured in Admin -> AI configuration -> Image generation.
TOGETHER_API_KEY=tgp_...
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# Key used to encrypt provider secrets saved from the Admin panel. Generate
# with: openssl rand -base64 32
# If unset, QORVYNA falls back to GITHUB_TOKEN_ENCRYPTION_KEY, then to the
# Firebase private key, so an existing deployment keeps working.
PROVIDER_SECRET_KEY=

# GitHub connection for Agent mode. Create a GitHub OAuth App whose callback is
# https://YOUR-DOMAIN/api/github/callback. Generate the encryption key with:
#   openssl rand -base64 32
# Access tokens are encrypted before they are stored in Firestore.
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=github-oauth-secret
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
GITHUB_OAUTH_CALLBACK_URL=https://qorvyna.thamjj13.top/api/github/callback

# HMAC pepper for birth-certificate numbers (never store the raw number).
# Generate with: openssl rand -base64 32
IDENTITY_PEPPER=replace-with-at-least-32-random-characters

# One-time first-admin bootstrap at /admin/setup. After any admin exists it is closed.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-bootstrap-key

# Application & family emails (server-only, Resend HTTPS API).
# Primary sender defaults to no-reply@qorvyna.top; fallbacks default to
# no-reply@matrix.thamjj13.top,no-reply@qorvyna.thamjj13.top. Domains MUST be
# verified in Resend (SPF/DKIM) before Resend accepts messages from them.
RESEND_API_KEY=
RESEND_FROM_PRIMARY=no-reply@qorvyna.top
RESEND_FROM_FALLBACKS=no-reply@matrix.thamjj13.top,no-reply@qorvyna.thamjj13.top
# Optional legacy single-sender alias (appended to fallbacks if set)
# RESEND_FROM_EMAIL=
# Optional environment-level parent notification email (leave empty unless explicitly managed; user parent links still require explicit consent verification)
# PARENT_NOTIFICATION_EMAIL=

# Maintenance job: POST /api/jobs/maintenance with "Authorization: Bearer
# $AUTOMATION_WORKER_SECRET" (32+ characters) from an external scheduler, every
# few minutes. It releases abandoned execution sessions and continues builds
# that were interrupted (server restart, time limit, provider outage). Without
# a scheduler, interrupted builds continue only when the user presses Continue.

# --- Optional QORVYNA settings ---------------------------------------------------
# The product was renamed from MATRIX to QORVYNA. Each setting below is also read
# under its former MATRIX_ name (MATRIX_TRUST_PROXY_HEADERS, …), so a deployment
# configured before the rename keeps working untouched. If both are set, the
# QORVYNA_ name wins.
#
# Also accept the origin named by the proxy's X-Forwarded-Host / X-Forwarded-Proto
# headers for same-origin checks. Set to "true" only behind a proxy that
# overwrites those headers itself.
# QORVYNA_TRUST_PROXY_HEADERS=true
#
# Android app updates: where the phone app downloads the APK, and its SHA-256.
# Unset, the URL is the latest GitHub release asset of this repository.
# QORVYNA_ANDROID_APK_URL=
# QORVYNA_ANDROID_APK_SHA256=
#
# Scheduling budget in tokens per minute (per server instance) for one model of
# the pool. The suffix is the model's registry key in capitals with every other
# character as "_": qwen3-32b -> QWEN3_32B. A real rate-limit answer from the
# provider always takes precedence.
# QORVYNA_MODEL_TPM_QWEN3_32B=12000
#
# Automation worker only (scripts/automation-worker.mjs): the deployed QORVYNA
# URL the worker calls.
# QORVYNA_WORKER_TARGET_URL=https://qorvyna.thamjj13.top
