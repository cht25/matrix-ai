{
  "name": "matrix-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MATRIX AI — AI Cyber Safety & Cybersecurity Education Platform for ages 11–17. Operated by THAMJJ13.TOP White Hat Team. Built on Firebase (Auth, Firestore, Storage) + Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "worker:automations": "node scripts/automation-worker.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:dry-run": "node scripts/seed.mjs --dry-run",
    "set-admin": "node scripts/set-admin.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "migrate:roles": "node scripts/migrate-roles.mjs",
    "migrate:roles:dry-run": "node scripts/migrate-roles.mjs --dry-run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "acorn": "^8.19.0",
    "cloudinary": "^2.10.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.525.0",
    "next": "^15.3.3",
    "pdfkit": "^0.15.2",
    "postcss": "^8.5.33",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "firebase-tools": "^15.27.0",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
